{
  "name": "tharkoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 4317 -H 0.0.0.0",
    "seed": "tsx scripts/seed.ts",
    "seed:v2": "tsx scripts/seed-v2.ts",
    "seed:dry-run": "tsx scripts/seed-v2.ts --dry-run",
    "seed:rollback": "tsx scripts/seed-v2.ts --rollback",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "NODE_OPTIONS=--max-old-space-size=256 next start -p 4317",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=3072 tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seo:check": "node scripts/seo-check.mjs",
    "local:prod": "node scripts/local-prod.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "mongoose": "^9.12.0",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
