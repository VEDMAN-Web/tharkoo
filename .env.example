# never commit real values
# Copy to .env.local for local dev. Production values live in /etc/tharkoo/prod.env
# and /etc/tharkoo/stg.env (chmod 600). CI uses memory Mongo and needs no real keys.
# Safe local defaults only: site URL and a localhost Mongo URI. Every secret stays empty.

NODE_ENV=
PORT=
SITE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317
SITE_NOINDEX=true
# Marks a new account's email verified at register. Refused unless SITE_NOINDEX=true.
# Staging has no mail provider, so leave this true there and unset it in production.
STAGING_AUTO_VERIFY_EMAIL=
MONGODB_URI=mongodb://127.0.0.1:27017/tharkoo
MONGODB_DB=
SESSION_SECRET=
CONTACT_ENCRYPTION_KEY=
CRON_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER_PREFIX=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
KYC_PROVIDER=manual
CSAM_PROVIDER=stub
SMS_PROVIDER=
SMS_API_KEY=
INDEXNOW_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LOG_LEVEL=
